    {
      "index": 2,
      "text": "a shadow chasing me I couldn't place",
      "start_s": 24.12,
      "end_s": 28.26
    },
    {
      "index": 3,
      "text": "I pulled over, and men in shades and suits,",
      "start_s": 28.6,
      "end_s": 33.6
    },
    {
      "index": 4,
      "text": "I reach for my ID to show them \u2026 and I do,",
